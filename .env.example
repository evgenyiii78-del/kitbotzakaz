# Не записывайте сюда реальные токены в архиве или GitHub.
FLOWWOW_TOKEN=YOUR_FLOWWOW_API_TOKEN
# На Bothost BOT_TOKEN обычно задаётся автоматически при создании бота.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Придумайте СВОЙ случайный код из 8+ символов; через /connect КОД привяжите чат.
SETUP_CODE=REPLACE_WITH_STRONG_PRIVATE_CODE
# Путь для постоянной базы Bothost:
DATABASE_PATH=/app/data/flowwow_orders.db
POLL_SECONDS=60
LOOKBACK_DAYS=2
